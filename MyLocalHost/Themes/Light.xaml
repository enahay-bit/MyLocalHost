<!-- ライトモードの色。キーは Dark.xaml と同じにする（画面からは DynamicResource で参照） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.WindowBg" Color="#F7F7F8" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E3E3E6" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1B1B1F" />
    <SolidColorBrush x:Key="Brush.TextSub" Color="#555559" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#666669" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#8A8A8F" />
    <SolidColorBrush x:Key="Brush.Link" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.Error" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.WarnText" Color="#B45309" />
    <SolidColorBrush x:Key="Brush.OkText" Color="#16A34A" />
    <SolidColorBrush x:Key="Brush.LampOff" Color="#B8B8BE" />
    <SolidColorBrush x:Key="Brush.LampOn" Color="#22C55E" />
    <SolidColorBrush x:Key="Brush.LampWarn" Color="#F59E0B" />
</ResourceDictionary>
