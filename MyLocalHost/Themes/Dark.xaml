<!-- ダークモードの色。キーは Light.xaml と同じにする（画面からは DynamicResource で参照） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.WindowBg" Color="#1C1C1E" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#2A2A2D" />
    <SolidColorBrush x:Key="Brush.Border" Color="#3C3C40" />
    <SolidColorBrush x:Key="Brush.Text" Color="#F2F2F4" />
    <SolidColorBrush x:Key="Brush.TextSub" Color="#BDBDC2" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A5A5AA" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#8C8C92" />
    <SolidColorBrush x:Key="Brush.Link" Color="#6EA8FE" />
    <SolidColorBrush x:Key="Brush.Error" Color="#F87171" />
    <SolidColorBrush x:Key="Brush.WarnText" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.OkText" Color="#4ADE80" />
    <SolidColorBrush x:Key="Brush.LampOff" Color="#5C5C63" />
    <SolidColorBrush x:Key="Brush.LampOn" Color="#22C55E" />
    <SolidColorBrush x:Key="Brush.LampWarn" Color="#F59E0B" />
</ResourceDictionary>
